rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitive Definition & Global Safety Gates
    function isSignedIn() {
      return true;
    }

    function isTeacher() {
      return true;
    }

    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Validation Blueprints (Anti-Update-Gap)

    function isValidProfile(data) {
      return data.keys().hasAll(['name', 'role', 'school', 'className', 'academicYear', 'avatar', 'email']) &&
             data.keys().size() == 7 &&
             data.name is string && data.name.size() <= 100 &&
             data.role is string && data.role.size() <= 100 &&
             data.school is string && data.school.size() <= 150 &&
             data.className is string && data.className.size() <= 30 &&
             data.academicYear is string && data.academicYear.size() <= 15 &&
             data.avatar is string && data.avatar.size() <= 5000000 &&
             data.email is string && data.email.size() <= 100;
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'name', 'gender', 'nisn', 'avatar', 'email', 'parentName', 'parentPhone']) &&
             (data.keys().size() == 8 || data.keys().size() == 9) &&
             data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() <= 100 &&
             (data.gender == 'Laki-laki' || data.gender == 'Perempuan') &&
             data.nisn is string && data.nisn.matches('^[0-9]{10}$') &&
             data.avatar is string && data.avatar.size() <= 2000 &&
             data.email is string && data.email.size() <= 100 &&
             data.parentName is string && data.parentName.size() <= 100 &&
             data.parentPhone is string && data.parentPhone.size() <= 30 &&
             (!data.keys().hasAll(['className']) || (data.className is string && data.className.size() <= 30));
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'date', 'category', 'target']) &&
             data.keys().size() == 6 &&
             data.id is string && isValidId(data.id) &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 2000 &&
             data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             (data.category == 'urgent' || data.category == 'umum' || data.category == 'akademik') &&
             (data.target == 'ortu' || data.target == 'siswa' || data.target == 'semua');
    }

    function isValidGrade(data) {
      return data.keys().hasAll(['studentId', 'grades']) &&
             data.keys().size() == 2 &&
             data.studentId is string && isValidId(data.studentId) &&
             data.grades is map && 
             data.grades.keys().hasAll(['muatanUmum', 'muatanKejuruan', 'mataPelajaranPilihan', 'kokurikuler']) &&
             data.grades.muatanUmum is int && data.grades.muatanUmum >= 0 && data.grades.muatanUmum <= 100 &&
             data.grades.muatanKejuruan is int && data.grades.muatanKejuruan >= 0 && data.grades.muatanKejuruan <= 100 &&
             data.grades.mataPelajaranPilihan is int && data.grades.mataPelajaranPilihan >= 0 && data.grades.mataPelajaranPilihan <= 100 &&
             data.grades.kokurikuler is int && data.grades.kokurikuler >= 0 && data.grades.kokurikuler <= 100;
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['date', 'records']) &&
             data.keys().size() == 2 &&
             data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.records is map;
    }

    function isValidUploadedReport(data) {
      return data.keys().hasAll(['id', 'studentId', 'fileName', 'fileSize', 'uploadDate', 'fileData']) &&
             data.keys().size() == 6 &&
             data.id is string && isValidId(data.id) &&
             data.studentId is string && isValidId(data.studentId) &&
             data.fileName is string && data.fileName.size() <= 255 &&
             data.fileSize is string && data.fileSize.size() <= 30 &&
             data.uploadDate is string && data.uploadDate.size() <= 50 &&
             data.fileData is string && data.fileData.size() <= 10000000; // Limit to ~10MB PDF chunks
    }

    // Teachers Profile Collection Rule
    match /profiles/{userId} {
      allow read: if true;
      allow create: if (userId == 'active_teacher' || (request.auth != null && userId == request.auth.uid)) && isValidProfile(incoming());
      allow update: if (userId == 'active_teacher' || (request.auth != null && userId == request.auth.uid)) && isValidProfile(incoming());
      allow delete: if false; // Profiles are permanent
    }

    // Students Collection Rule
    match /students/{studentId} {
      allow read: if true;
      allow create: if isValidStudent(incoming()) && isValidId(studentId);
      allow update: if isValidStudent(incoming()) && isValidId(studentId);
      allow delete: if isValidId(studentId);
    }

    // Announcements Collection Rule
    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if isValidAnnouncement(incoming()) && isValidId(announcementId);
      allow update: if isValidAnnouncement(incoming()) && isValidId(announcementId);
      allow delete: if isValidId(announcementId);
    }

    // Grades Collection Rule
    match /grades/{gradeId} {
      allow read: if true;
      allow create: if isValidGrade(incoming()) && isValidId(gradeId);
      allow update: if isValidGrade(incoming()) && isValidId(gradeId);
      allow delete: if isValidId(gradeId);
    }

    // Attendance Collection Rule
    match /attendance/{attendanceId} {
      allow read: if true;
      allow create: if isValidAttendance(incoming()) && isValidId(attendanceId);
      allow update: if isValidAttendance(incoming()) && isValidId(attendanceId);
      allow delete: if isValidId(attendanceId);
    }

    // Uploaded PDF Reports Collection Rule
    match /uploadedReports/{reportId} {
      allow read: if true;
      allow create: if isValidUploadedReport(incoming()) && isValidId(reportId);
      allow update: if isValidUploadedReport(incoming()) && isValidId(reportId);
      allow delete: if isValidId(reportId);
    }
  }
}
